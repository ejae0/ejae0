{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated customer profile and shipping defaults for MONO:DAY My Page.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 120
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "phone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
        },
        "address": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "bodySpecs": {
          "type": "string",
          "maxLength": 50
        },
        "membershipTier": {
          "type": "string",
          "enum": ["WELCOME", "SILVER", "GOLD", "BLACK"]
        },
        "points": {
          "type": "number"
        },
        "agreedTerms": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "email",
        "name",
        "phone",
        "address",
        "bodySpecs",
        "membershipTier",
        "points",
        "agreedTerms",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserCoupon": {
      "title": "UserCoupon",
      "description": "Discount coupon issued to or claimed by a user.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "code": {
          "type": "string",
          "minLength": 2,
          "maxLength": 32,
          "enum": ["WELCOME15", "MONODAY15", "MATINKIM15", "SPRING10", "FIRST5000"]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "maxLength": 200
        },
        "discountType": {
          "type": "string",
          "enum": ["percent", "fixed"]
        },
        "discountValue": {
          "type": "number"
        },
        "minOrderAmount": {
          "type": "number"
        },
        "status": {
          "type": "string",
          "enum": ["available", "used", "expired"]
        },
        "expiresAt": {
          "type": "string",
          "maxLength": 20
        },
        "usedOrderId": {
          "type": "string",
          "maxLength": 64
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "userId",
        "code",
        "title",
        "description",
        "discountType",
        "discountValue",
        "minOrderAmount",
        "status",
        "expiresAt",
        "usedOrderId",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserOrder": {
      "title": "UserOrder",
      "description": "Customer order record including status and cancellation/return tracking.",
      "type": "object",
      "properties": {
        "orderNumber": {
          "type": "string",
          "minLength": 4,
          "maxLength": 40
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "recipientName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "recipientPhone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
        },
        "shippingAddress": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "deliveryNote": {
          "type": "string",
          "maxLength": 200
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["card", "npay", "kpay", "bank"]
        },
        "couponCode": {
          "type": "string",
          "maxLength": 32
        },
        "rawTotal": {
          "type": "number"
        },
        "discountAmount": {
          "type": "number"
        },
        "finalPrice": {
          "type": "number"
        },
        "status": {
          "type": "string",
          "enum": [
            "paid",
            "preparing",
            "shipped",
            "delivered",
            "cancel_requested",
            "cancelled",
            "return_requested",
            "returned"
          ]
        },
        "cancelReturnType": {
          "type": "string",
          "enum": ["", "cancel", "return"]
        },
        "cancelReturnReason": {
          "type": "string",
          "maxLength": 300
        },
        "items": {
          "type": "array"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "orderNumber",
        "userId",
        "recipientName",
        "recipientPhone",
        "shippingAddress",
        "deliveryNote",
        "paymentMethod",
        "couponCode",
        "rawTotal",
        "discountAmount",
        "finalPrice",
        "status",
        "cancelReturnType",
        "cancelReturnReason",
        "items",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserReview": {
      "title": "UserReview",
      "description": "Product review written by an authenticated customer.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "productId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "productName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "productBrand": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "productImage": {
          "type": "string",
          "maxLength": 500
        },
        "orderId": {
          "type": "string",
          "maxLength": 64
        },
        "selectedOption": {
          "type": "string",
          "maxLength": 80
        },
        "userSpecs": {
          "type": "string",
          "maxLength": 50
        },
        "rating": {
          "type": "number"
        },
        "content": {
          "type": "string",
          "minLength": 5,
          "maxLength": 1000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "userId",
        "productId",
        "productName",
        "productBrand",
        "productImage",
        "orderId",
        "selectedOption",
        "userSpecs",
        "rating",
        "content",
        "createdAt",
        "updatedAt"
      ]
    },
    "CustomerInquiry": {
      "title": "CustomerInquiry",
      "description": "1:1 customer service inquiry submitted by a user.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "category": {
          "type": "string",
          "enum": ["배송", "주문/결제", "취소/반품/교환", "상품문의", "쿠폰/회원"]
        },
        "orderNumber": {
          "type": "string",
          "maxLength": 40
        },
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "content": {
          "type": "string",
          "minLength": 5,
          "maxLength": 2000
        },
        "status": {
          "type": "string",
          "enum": ["접수완료", "답변완료"]
        },
        "reply": {
          "type": "string",
          "maxLength": 2000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "userId",
        "category",
        "orderNumber",
        "title",
        "content",
        "status",
        "reply",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private customer profile containing PII and membership metadata."
    },
    "/users/{userId}/coupons/{couponId}": {
      "schema": { "$ref": "#/entities/UserCoupon" },
      "description": "Coupons owned by the user."
    },
    "/users/{userId}/orders/{orderId}": {
      "schema": { "$ref": "#/entities/UserOrder" },
      "description": "Orders and cancellation/return records owned by the user."
    },
    "/users/{userId}/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/UserReview" },
      "description": "Product reviews authored by the user."
    },
    "/users/{userId}/inquiries/{inquiryId}": {
      "schema": { "$ref": "#/entities/CustomerInquiry" },
      "description": "1:1 customer service inquiries submitted by the user."
    }
  }
}
