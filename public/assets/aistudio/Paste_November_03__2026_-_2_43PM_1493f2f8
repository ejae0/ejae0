        function setGenderFilter(gender) {
            currentGender = gender;
            currentSubCategory = 'all';

            // Button Styles Toggle
            const btnWomen = document.getElementById('gender-btn-women');
            const btnMen = document.getElementById('gender-btn-men');

            if (gender === 'women') {
                btnWomen.className = 'px-5 py-2 rounded-full text-xs font-bold tracking-widest transition-all bg-black text-white';
                btnMen.className = 'px-5 py-2 rounded-full text-xs font-bold tracking-widest transition-all bg-white border border-gray-200 text-gray-600 hover:border-black';
            } else {
                btnMen.className = 'px-5 py-2 rounded-full text-xs font-bold tracking-widest transition-all bg-black text-white';
                btnWomen.className = 'px-5 py-2 rounded-full text-xs font-bold tracking-widest transition-all bg-white border border-gray-200 text-gray-600 hover:border-black';
            }

            renderSubcategories();
            renderProducts();
        }

        function renderSubcategories() {
            const container = document.getElementById('subcat-container');
            const list = SUBCATEGORIES[currentGender];
            
            container.innerHTML = list.map(sub => {
                const isActive = sub.id === currentSubCategory;
                const activeClass = isActive 
                    ? 'bg-gray-900 text-white font-bold shadow-sm' 
                    : 'bg-white text-gray-600 border border-gray-200 hover:border-black';
                return `<button onclick="setSubCategory('${sub.id}')" class="px-3.5 py-1.5 rounded-full transition-all ${activeClass}">${sub.label}</button>`;
            }).join('');
        }

        function setSubCategory(subId) {
            currentSubCategory = subId;
            renderSubcategories();
            renderProducts();
        }

        function renderProducts() {
            const grid = document.getElementById('product-catalog-grid');
            const filterText = document.getElementById('active-filter-text');
            const countText = document.getElementById('product-count-text');

            // Filter logic
            const filtered = PRODUCTS.filter(p => {
                const matchGender = p.gender === currentGender;
                const matchSub = currentSubCategory === 'all' || p.category === currentSubCategory;
                return matchGender && matchSub;
            });

            // Update UI Texts
            const subObj = SUBCATEGORIES[currentGender].find(s => s.id === currentSubCategory);
            filterText.textContent = `${currentGender.toUpperCase()} > ${subObj ? subObj.label : '전체'}`;
            countText.textContent = `${filtered.length} ITEMS`;

            if (filtered.length === 0) {
                grid.innerHTML = `<div class="col-span-4 py-20 text-center text-gray-400 font-light">해당 분류에 등록된 상품이 없습니다.</div>`;
                return;
            }

            grid.innerHTML = filtered.map(item => {
                const isWished = wishlist.includes(item.id);
                const wishIconClass = isWished ? 'fa-solid fa-heart text-brand-accent' : 'fa-regular fa-heart';
                const formattedPrice = item.price.toLocaleString();

                return `
                <div class="product-card group">
                    <div class="relative w-full aspect-[3/4] bg-gray-100 rounded-lg overflow-hidden mb-4">
                        <img src="${item.img1}" data-hover="${item.img2}" class="product-img w-full h-full object-cover transition-opacity duration-500" alt="${item.name}">
                        <button onclick="toggleWishlistById('${item.id}')" class="absolute top-3 right-3 w-8 h-8 rounded-full bg-white/80 backdrop-blur-sm flex items-center justify-center text-gray-600 hover:text-brand-accent transition-colors z-10 shadow-sm">
                            <i class="${wishIconClass} text-sm wish-icon-${item.id}"></i>
                        </button>
                        <div onclick="addToCartById('${item.id}')" class="absolute bottom-0 inset-x-0 bg-black/90 text-white text-[11px] py-2.5 text-center font-medium opacity-0 group-hover:opacity-100 transition-opacity cursor-pointer uppercase tracking-wider">
                            + Add to Shopping Bag
                        </div>
                    </div>
                    <div>
                        <div class="flex justify-between items-center text-[10px] font-bold tracking-widest text-gray-400 uppercase">
                            <span>${item.brand}</span>
                        </div>
                        <h3 class="text-xs font-medium text-gray-900 mt-1 truncate group-hover:underline cursor-pointer" onclick="addToCartById('${item.id}')">${item.name}</h3>
                        <div class="flex items-center space-x-2 mt-2">
                            <span class="text-xs font-bold font-mono">₩${formattedPrice}</span>
                            ${item.discount > 0 ? `<span class="text-[10px] text-brand-accent font-bold font-mono">${item.discount}%</span>` : ''}
                        </div>
                    </div>
                </div>
                `;
            }).join('');

            bindImageHoverEvents();
        }

        function scrollToShop(gender, sub) {
            const shopSec = document.getElementById('shop');
            if (shopSec) shopSec.scrollIntoView({ behavior: 'smooth' });
            setGenderFilter(gender);
            if(sub) setSubCategory(sub);
        }

        // ==========================================
        // 3. WISHLIST & CART ENGINE (INTERACTION & DRAWERS)
        // ==========================================
        function toggleWishlistById(id) {
            const index = wishlist.indexOf(id);
            const item = PRODUCTS.find(p => p.id === id);
            const title = item ? item.name : '상품';

            if (index > -1) {
                wishlist.splice(index, 1);
                showToast(`'${title}' 좋아요 목록에서 삭제되었습니다.`);
            } else {
                wishlist.push(id);
                showToast(`'${title}' 좋아요 목록에 추가되었습니다.`, 'heart');
            }

            updateBadges();
            renderWishlistDrawer();
            renderProducts(); 
        }

        function addToCartById(id) {
            const existing = cart.find(c => c.id === id);
            const item = PRODUCTS.find(p => p.id === id);
            const title = item ? item.name : '상품';

            if (existing) {
                existing.qty++;
            } else {
                cart.push({ id, qty: 1 });
            }

            showToast(`'${title}' 장바구니에 담겼습니다.`, 'bag');
            updateBadges();
            renderCartDrawer();
        }

        function updateCartQty(id, delta) {
            const target = cart.find(c => c.id === id);
            if (target) {
                target.qty += delta;
                if (target.qty <= 0) {
                    cart = cart.filter(c => c.id !== id);
                }
            }
            updateBadges();
            renderCartDrawer();
        }

        function removeFromCart(id) {
            cart = cart.filter(c => c.id !== id);
            updateBadges();
            renderCartDrawer();
        }

        function updateBadges() {
            const wishBadge = document.getElementById('wish-count');
            const cartBadge = document.getElementById('cart-count');
            const drawerWishCount = document.getElementById('drawer-wish-count');
            const drawerCartCount = document.getElementById('drawer-cart-count');

            const totalWish = wishlist.length;
            const totalCart = cart.reduce((sum, item) => sum + item.qty, 0);

            wishBadge.textContent = totalWish;
            cartBadge.textContent = totalCart;
            drawerWishCount.textContent = `(${totalWish})`;
            drawerCartCount.textContent = `(${totalCart})`;
        }

        function renderWishlistDrawer() {
            const container = document.getElementById('wishlist-items-container');
            
