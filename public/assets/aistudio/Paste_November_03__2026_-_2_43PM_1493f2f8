                `;
                return;
            }

            const items = wishlist.map(id => PRODUCTS.find(p => p.id === id)).filter(Boolean);
            container.innerHTML = items.map(item => `
                <div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg border border-gray-100">
                    <div class="flex items-center space-x-3">
                        <img src="${item.img1}" class="w-14 h-16 object-cover rounded" alt="${item.name}">
                        <div>
                            <span class="text-[9px] font-bold text-gray-400 uppercase">${item.brand}</span>
                            <h4 class="text-xs font-medium text-black truncate w-40">${item.name}</h4>
                            <p class="text-xs font-mono font-bold mt-1">₩${item.price.toLocaleString()}</p>
                        </div>
                    </div>
                    <div class="flex flex-col space-y-2 items-end">
                        <button onclick="toggleWishlistById('${item.id}')" class="text-gray-400 hover:text-red-500 text-xs">
                            <i class="fa-solid fa-trash-can"></i>
                        </button>
                        <button onclick="addToCartById('${item.id}')" class="text-[10px] bg-black text-white px-2.5 py-1 rounded uppercase font-medium hover:bg-gray-800">
                            + Cart
                        </button>
                    </div>
                </div>
            `).join('');
        }

        function renderCartDrawer() {
            const container = document.getElementById('cart-items-container');
            const totalPriceEl = document.getElementById('cart-total-price');
            
            if (cart.length === 0) {
                container.innerHTML = `
                    <div class="h-64 flex flex-col items-center justify-center text-gray-400 space-y-3">
                        <i class="fa-solid fa-bag-shopping text-4xl stroke-1"></i>
                        <p class="text-xs font-light">장바구니가 비어있습니다.</p>
                    </div>
                `;
                totalPriceEl.textContent = '₩0';
                return;
            }

            let total = 0;
            container.innerHTML = cart.map(cItem => {
                const item = PRODUCTS.find(p => p.id === cItem.id);
                if (!item) return '';
                const itemTotal = item.price * cItem.qty;
                total += itemTotal;

                return `
                <div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg border border-gray-100">
                    <div class="flex items-center space-x-3">
                        <img src="${item.img1}" class="w-14 h-16 object-cover rounded" alt="${item.name}">
                        <div>
                            <span class="text-[9px] font-bold text-gray-400 uppercase">${item.brand}</span>
                            <h4 class="text-xs font-medium text-black truncate w-36">${item.name}</h4>
                            <p class="text-xs font-mono font-bold mt-1">₩${item.price.toLocaleString()}</p>
                        </div>
                    </div>
                    <div class="flex flex-col items-end justify-between h-full space-y-3">
                        <button onclick="removeFromCart('${item.id}')" class="text-gray-400 hover:text-black text-xs">
                            <i class="fa-solid fa-xmark"></i>
                        </button>
                        <div class="flex items-center space-x-2 border border-gray-300 bg-white rounded px-2 py-0.5 text-xs">
                            <button onclick="updateCartQty('${item.id}', -1)" class="text-gray-500 hover:text-black">-</button>
                            <span class="font-mono font-bold w-4 text-center">${cItem.qty}</span>
                            <button onclick="updateCartQty('${item.id}', 1)" class="text-gray-500 hover:text-black">+</button>
                        </div>
                    </div>
                </div>
                `;
            }).join('');

            totalPriceEl.textContent = `₩${total.toLocaleString()}`;
        }

        function toggleDrawer(type) {
            const overlay = document.getElementById(`${type}-drawer-overlay`);
            const drawer = document.getElementById(`${type}-drawer`);

            const isOpen = !drawer.classList.contains('translate-x-full');
            if (isOpen) {
                drawer.classList.add('translate-x-full');
                overlay.classList.add('opacity-0', 'pointer-events-none');
            } else {
                if (type === 'wishlist') renderWishlistDrawer();
                if (type === 'cart') renderCartDrawer();
                drawer.classList.remove('translate-x-full');
                overlay.classList.remove('opacity-0', 'pointer-events-none');
            }
        }

        function checkoutMock() {
            if (cart.length === 0) {
                showToast('장바구니가 비어있어 주문할 수 없습니다.');
                return;
            }
            showToast('주문 결제 페이지로 이동합니다.');
            setTimeout(() => {
                toggleDrawer('cart');
            }, 1000);
        }

        function showToast(msg, iconType = 'info') {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            
            let iconHtml = '<i class="fa-solid fa-circle-info text-blue-400"></i>';
            if (iconType === 'heart') iconHtml = '<i class="fa-solid fa-heart text-brand-accent"></i>';
            if (iconType === 'bag') iconHtml = '<i class="fa-solid fa-bag-shopping text-green-400"></i>';

            toast.className = 'bg-black/90 text-white text-xs px-5 py-3.5 rounded-lg shadow-2xl backdrop-blur-md flex items-center space-x-3 pointer-events-auto transform transition-all duration-300 translate-y-2 opacity-0';
            toast.innerHTML = `${iconHtml}<span>${msg}</span>`;

            container.appendChild(toast);
            
            setTimeout(() => {
                toast.classList.remove('translate-y-2', 'opacity-0');
            }, 10);

            setTimeout(() => {
                toast.classList.add('opacity-0');
                setTimeout(() => toast.remove(), 300);
            }, 2500);
        }

        function bindImageHoverEvents() {
            document.querySelectorAll('.product-img').forEach(img => {
                const hoverSrc = img.dataset.hover;
                if (hoverSrc) {
                    const parent = img.parentElement;
                    parent.onmouseenter = () => { img.src = hoverSrc; };
                    parent.onmouseleave = () => { img.src = img.src.replace(hoverSrc, img.getAttribute('src')); };
                }
            });
        }

        // ==========================================
        // 4. HERO SLIDER LOGIC & INIT
        // ==========================================
        let currentSlide = 0;
        const slides = document.querySelectorAll('.hero-slide');
        const dots = document.querySelectorAll('.slide-dot');
        const slideNum = document.getElementById('current-slide-num');

        function setSlide(index) {
            slides.forEach((slide, i) => {
                slide.style.opacity = i === index ? '1' : '0';
            });
            dots.forEach((dot, i) => {
                if (i === index) {
                    dot.classList.remove('w-3', 'bg-white/40');
                    dot.classList.add('w-8', 'bg-white');
                } else {
                    dot.classList.remove('w-8', 'bg-white');
                    dot.classList.add('w-3', 'bg-white/40');
                }
            });
            currentSlide = index;
            slideNum.textContent = `0${index + 1}`;
        }

        setInterval(() => {
            let next = (currentSlide + 1) % slides.length;
            setSlide(next);
        }, 6000);

        // Search Modal Listeners
        const searchBtn = document.getElementById('search-btn');
        const searchModal = document.getElementById('search-modal');
        const closeSearch = document.getElementById('close-search');

        searchBtn.addEventListener('click', () => searchModal.classList.remove('hidden'));
        closeSearch.addEventListener('click', () => searchModal.classList.add('hidden'));

        // INITIALIZE ON LOAD
        window.onload = function() {
            setGenderFilter('women');
            updateBadges();
        };
    </script>
</body>
</html>