    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            black: '#111111',
                            gray: '#757575',
                            lightgray: '#f5f5f7',
                            border: '#e5e5e5',
                            accent: '#ff334b'
                        }
                    },
                    fontFamily: {
                        sans: ['Noto Sans KR', 'sans-serif'],
                        serif: ['Cormorant Garamond', 'serif']
                    }
